SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
API_KEY=replace_with_a_random_secret_for_api
PORT=3000

# Note:
# - SUPABASE_URL: your Supabase project URL
# - SUPABASE_SERVICE_ROLE_KEY: use the Service Role key ONLY on the backend
# - API_KEY: optional backend access secret for /api/* requests
# - Do NOT commit a real .env to git. Use your Git host's secrets/env settings.
